[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ yml.agent.description }}"
readme = "README.md"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">=3.13,<3.14"
dependencies = [
    "psycopg-pool>=3.3.1",
    "psycopg[binary]>=3.3.4",
    "python-dotenv>=1.2.2",
    "pyjwt[crypto]>=2.8.0",
    "cryptography>=44.0.0",
    "pyyaml>=6.0.2",
    "stripe>=15.2.1",
    "uagents>=0.25.2",
]
keywords = ["agent", "agentverse", "asi1"]

[dependency-groups]
dev = [
    "black>=26.1.0",
    "mypy>=2.1.0",
    "ruff>=0.15.2",
    "types-PyYAML>=6.0.12",
]

[project.scripts]
agent = "runtime:main"

[build-system]
requires = ["hatchling>=1.25.0"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/agent", "src/runtime", "src/shared"]

[tool.hatch.build.targets.sdist]
packages = ["src/agent", "src/runtime", "src/shared"]

[tool.ruff]
line-length = 88
target-version = "py313"
fix = true

[tool.ruff.lint]
select = [
    "E",
    "W",
    "F",
    "I",
    "UP",
    "B",
    "SIM",
    "C4",
]
ignore = [
    "E501",
]

[tool.ruff.lint.isort]
known-first-party = ["agent", "runtime", "shared"]

[tool.black]
line-length = 88
target-version = ["py313"]

[tool.mypy]
python_version = "3.13"
mypy_path = ["src"]
explicit_package_bases = true
warn_unused_configs = true
warn_return_any = true
warn_unused_ignores = true
no_implicit_optional = true
check_untyped_defs = true
exclude = ["tests/"]

[[tool.mypy.overrides]]
module = [
    "uagents.*",
    "uagents_core.*",
    "stripe.*",
]
ignore_missing_imports = true

[[tool.mypy.overrides]]
module = "agent.test"
disable_error_code = ["union-attr"]

[[tool.mypy.overrides]]
module = "runtime.payments.stripe"
disable_error_code = ["arg-type"]

[[tool.mypy.overrides]]
module = ["shared.db", "runtime.pipeline"]
disable_error_code = ["no-any-return", "return-value", "arg-type"]
