# Agentverse (optional — uAgents uses its own defaults when unset)
AGENTVERSE_API_KEY={{ secrets.agentverse_api_key or '' }}

AGENT_SEED={{ secrets.agent_seed }}

# Postgres — use a strong password in production; never commit .env
POSTGRES_HOST={{ secrets.postgres_host }}
POSTGRES_PORT={{ secrets.postgres_port }}
POSTGRES_DATABASE={{ secrets.postgres_database }}
POSTGRES_USER={{ secrets.postgres_user }}
POSTGRES_PASSWORD={{ secrets.postgres_password }}

# Optional Stripe secrets (required when stripe payments are enabled in agent.yml)
STRIPE_SECRET_KEY={{ secrets.stripe_secret_key or '' }}
STRIPE_PUBLISHABLE_KEY={{ secrets.stripe_publishable_key or '' }}

# Optional Skyfire secrets (required when skyfire payments are enabled in agent.yml)
SKYFIRE_API_KEY={{ secrets.skyfire_api_key or '' }}
SKYFIRE_SELLER_ACCOUNT_ID={{ secrets.skyfire_seller_account_id or '' }}
SKYFIRE_SERVICE_ID={{ secrets.skyfire_service_id or '' }}

# Optional FET LCD REST override (defaults: Dorado testnet / Fetchhub mainnet)
# FET_LCD_URL={{ secrets.fet_lcd_url or '' }}

AGENT_PORT={{ secrets.agent_port }}
