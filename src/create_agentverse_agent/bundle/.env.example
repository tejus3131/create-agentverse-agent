# Agentverse (optional — uAgents uses its own defaults when unset)
AGENTVERSE_API_KEY=
AGENT_SEED=

# Postgres — use a strong password in production; never commit .env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=agent
POSTGRES_USER=agent_pod
POSTGRES_PASSWORD=change-me

# Optional Stripe secrets (required for Stripe payments)
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# Optional Skyfire secrets (required for Skyfire payments)
SKYFIRE_API_KEY=<your-skyfire-api-key>
SKYFIRE_SELLER_ACCOUNT_ID=<your-skyfire-seller-account-id>
SKYFIRE_SERVICE_ID=<your-skyfire-service-id>


# Optional FET LCD REST override (defaults: Dorado testnet / Fetchhub mainnet)
# FET_LCD_URL=https://rest-dorado.fetch.ai

AGENT_PORT=8000
